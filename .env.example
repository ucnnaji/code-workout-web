# Local development only: copy to .env. Never commit .env or real credentials.
NODE_ENV=development
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=REPLACE_WITH_BACKEND_SECRET_KEY
# Generate each of these independently; scripts/generate-secrets.mjs prints suggestions locally.
ADMIN_TOKEN=REPLACE_WITH_RANDOM_RESEARCH_ADMIN_TOKEN
COMPENSATION_ADMIN_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_PAYMENT_ADMIN_TOKEN
PII_ENCRYPTION_KEY=REPLACE_WITH_CANONICAL_BASE64_OF_EXACTLY_32_RANDOM_BYTES
# Keep false until content, IRB/data-storage review and acceptance tests are complete.
LIVE_COLLECTION_ENABLED=false
# Required only when AI feedback is enabled and used. Set a model your API project can access.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
# Per web-process outbound concurrency. Total concurrency multiplies when Render runs multiple instances.
OPENAI_MAX_CONCURRENCY=120
# Code execution. Judge0 runtime IDs are discovered automatically when omitted.
# For live research, use the execution service covered by your approved data-handling plan.
EXECUTION_PROVIDER=judge0
JUDGE0_URL=https://ce.judge0.com
JUDGE0_MAX_CONCURRENCY=120
JUDGE0_PYTHON_ID=
JUDGE0_JAVA_ID=
JUDGE0_AUTH_TOKEN=
JUDGE0_RAPIDAPI_KEY=
